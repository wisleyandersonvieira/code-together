# Copie para .env e preencha. O .env NÃO vai para o git (ver .gitignore).
#
# Apenas chaves PÚBLICAS entram aqui: tudo com prefixo VITE_ é embutido no
# bundle e fica visível no navegador. Nunca coloque a service_role key, a senha
# do banco ou qualquer segredo neste arquivo.
#
# Os segredos das edge functions (SUPABASE_SERVICE_ROLE_KEY, APP_DB_URL,
# ALLOWED_ORIGIN) são configurados no painel do Supabase
# (Edge Functions → Secrets), nunca no front.

# ID do projeto Supabase (ex.: abcdefghijklmnopqrst)
VITE_SUPABASE_PROJECT_ID=your-project-id

# URL do projeto (ex.: https://abcdefghijklmnopqrst.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave publishable/anon — pública por design, protegida por RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
